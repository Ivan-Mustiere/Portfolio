# Partagé entre frontend et docker-backend
DOCKER_BACKEND_SECRET=change-me

# IP ou domaine affiché dans les URLs de démo (ex: mon-vps.com ou 12.34.56.78)
VPS_HOST=localhost

# Préfixe HTTPS pour les iframes de démo — doit être HTTPS en prod pour éviter le mixed content
# nginx doit proxifier /demo/PORT/ → http://127.0.0.1:PORT/ (voir section nginx ci-dessous)
VPS_URL_PREFIX=https://ivan-mustiere.com

# Chemin absolu vers le dossier projets/ côté hôte (nécessaire quand docker-backend tourne en conteneur)
# Exemple: /home/ivan/Portfolio/projets
PROJECTS_HOST_DIR=/home/ivan/Portfolio/projets
