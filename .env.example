# Partagé entre frontend et docker-backend
DOCKER_BACKEND_SECRET=change-me

# IP ou domaine affiché dans les URLs de démo (ex: mon-vps.com ou 12.34.56.78)
VPS_HOST=localhost

# Préfixe HTTPS pour les iframes de démo — doit être HTTPS en prod pour éviter le mixed content
# nginx doit proxifier /demo/PORT/ → http://172.17.0.1:PORT/ (voir CLAUDE.md, section nginx)
VPS_URL_PREFIX=https://ivan-mustiere.com

# Chemin absolu (obligatoire) vers le dossier projets/ côté hôte, monté au même chemin dans docker-backend
# pour que les montages relatifs des démos (ex. provisioning Grafana) pointent au bon endroit
# Exemple: /home/ivan/Portfolio/projets
PROJECTS_HOST_DIR=/home/ivan/Portfolio/projets

# IP de l'hôte sur laquelle les ports des démos sont publiés (passerelle docker0, jamais 0.0.0.0)
# Vérifier avec : ip -4 addr show docker0
DEMO_BIND_IP=172.17.0.1

# Nombre max de démos simultanées (Airflow ≈ 1,5 Go chacune)
MAX_SESSIONS=3

# Analytics Plausible — laisser vide pour désactiver
# Créer un compte sur https://plausible.io et ajouter le domaine
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ivan-mustiere.com
